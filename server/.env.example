# NO pongas estas claves en app.js ni en stripe-config.js.
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZA_AQUI
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_AQUI
PORT=4242


# V127.42 · Persistencia PostgreSQL.
# auto = usa PostgreSQL si DATABASE_URL existe; si no, mantiene JSON local.
# En Railway se recomienda DATA_BACKEND=postgres y usar la DATABASE_URL inyectada por PostgreSQL.
DATA_BACKEND=auto
DATABASE_URL=
# V127.43: Wasmer puede inyectar PostgreSQL automáticamente mediante DB_HOST,
# DB_PORT, DB_NAME, DB_USERNAME y DB_PASSWORD. No copies esos secretos al código.
# Si esas cinco variables existen, DATA_BACKEND=postgres funciona sin DATABASE_URL.
# Railway con red privada normalmente no requiere SSL adicional. Si tu proveedor exige TLS usa true.
# Si un proveedor entrega un certificado no verificable y lo documenta expresamente, usa no-verify solo como último recurso.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# V127.41 · Seguridad / proxy.
# Para pruebas en localhost usa estos valores. En Wasmer/producción cambia NODE_ENV=production
# y configura TRUST_PROXY_HOPS con el número real de proxies confiables delante de Node (normalmente 1).
TRUST_PROXY_HOPS=0
NODE_ENV=development

# Reservas temporales para evitar que pedidos no pagados bloqueen inventario indefinidamente.
COD_RESERVATION_HOURS=48
BANK_PROOF_REVIEW_HOURS=48


# Ruta privada del panel. Usa un nombre largo y difícil de adivinar.
# Ejemplo: /gestion-nr-9f3k2m8q
ADMIN_PATH=/CAMBIA_ESTA_RUTA_PRIVADA

# Contraseña privada del panel
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA

# PayPal Checkout. Usa sandbox mientras hacemos pruebas.
PAYPAL_CLIENT_ID=REEMPLAZA_CLIENT_ID_SANDBOX
PAYPAL_CLIENT_SECRET=REEMPLAZA_CLIENT_SECRET_SANDBOX
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=REEMPLAZA_CON_EL_WEBHOOK_ID_DE_PAYPAL

# Para pruebas con correos de cuenta usa el túnel HTTPS activo (Cloudflare).
# En producción usa el dominio definitivo, por ejemplo: https://niñosrancios.com
PUBLIC_BASE_URL=

# Mercado Pago Checkout Pro (Preferences API). Usa credenciales de prueba primero.
MERCADOPAGO_ACCESS_TOKEN=TEST-REEMPLAZA_ACCESS_TOKEN_DE_PRUEBA
# La clave secreta se obtiene en Tus integraciones > Webhooks > Configurar notificaciones.
MERCADOPAGO_WEBHOOK_SECRET=REEMPLAZA_CLAVE_SECRETA_WEBHOOK
# Para Mercado Pago en localhost usa una URL HTTPS pública (por ejemplo Cloudflare Tunnel).
# Ejemplo: https://palabras-aleatorias.trycloudflare.com

# Brevo SMTP · correos transaccionales
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=REEMPLAZA_CON_TU_LOGIN_SMTP_DE_BREVO
BREVO_SMTP_KEY=REEMPLAZA_CON_TU_SMTP_KEY

# Brevo usa la forma Punycode del dominio con ñ.
BREVO_FROM_ORDERS=pedidos@xn--niosrancios-2db.com
BREVO_FROM_ACCOUNTS=cuentas@xn--niosrancios-2db.com
BREVO_FROM_CONTACT=contacto@xn--niosrancios-2db.com

# Correo interno que recibirá avisos de nuevos pedidos y del formulario de contacto.
STORE_NOTIFICATION_EMAIL=TU_CORREO_DE_TIENDA@gmail.com
STORE_NAME=Niños Rancios

# Brevo Marketing API · newsletter del footer (NO es la SMTP Key)
BREVO_API_KEY=REEMPLAZA_CON_TU_API_KEY_DE_BREVO
BREVO_NEWSLETTER_LIST_ID=REEMPLAZA_CON_EL_ID_DE_LA_LISTA

# V127.9 · Protección temporal de Colaboraciones
# Esta contraseña se usa como valor INICIAL. Después puedes bloquear/desbloquear la página desde el panel.
COLLABORATIONS_PASSWORD=CAMBIA_ESTA_CONTRASENA_TEMPORAL

# V127.45 · Mantenimiento PostgreSQL aislado para staging/Wasmer.
# Mantén DATA_BACKEND=json mientras validas la migración.
# check   = comprueba conexión, crea esquema si falta y muestra conteos.
# migrate = importa los seis JSON críticos a PostgreSQL dentro de una transacción.
# Después de una ejecución correcta vuelve a dejar esta variable vacía.
POSTGRES_MAINTENANCE_ACTION=
# NO actives force salvo que exista un respaldo y quieras vaciar/reimportar deliberadamente.
POSTGRES_MIGRATION_FORCE=false
